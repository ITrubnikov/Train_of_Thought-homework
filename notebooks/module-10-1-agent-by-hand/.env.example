# .env для локального запуска ноутбука модуля 10.1 (агент руками).
#
# Использование:
#   cp .env.example .env      # скопируйте этот шаблон в .env
#   # впишите свои значения, затем запустите ноутбук (Run all)
#
# .env лежит в .gitignore — реальные ключи в репозиторий НЕ попадут (коммитится только .env.example).
# Ноутбук читает .env с override=True, поэтому смена PROVIDER подхватывается БЕЗ перезапуска ядра —
# достаточно заново прогнать ячейку с клиентом.

# ── ПЕРЕКЛЮЧАТЕЛЬ ПРОВАЙДЕРА ────────────────────────────────────────────────────
# hf      — HF Inference (по умолчанию; нужен HF_TOKEN ниже)
# minimax — MiniMax        (нужен MINIMAX_API_KEY ниже)
PROVIDER=hf

# ── HF Inference (для PROVIDER=hf) ──────────────────────────────────────────────
# Бесплатный токен: https://huggingface.co/settings/tokens  (роль read).
# Тот же HF_TOKEN, что в модулях 10 и 10.7 — нового заводить не нужно.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# ── MiniMax (для PROVIDER=minimax) ──────────────────────────────────────────────
# Чтобы включить: поставь PROVIDER=minimax выше и впиши свой ключ.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
