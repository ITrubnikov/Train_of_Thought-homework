# .env для локального запуска ноутбука модуля 10.1 (агент руками).
#
# Использование:
#   cp .env.example .env      # скопируйте этот шаблон
#   # впишите свои значения в .env
#   # затем: jupyter lab notebook.ipynb  (ноутбук сам подхватит .env через load_dotenv)
#
# .env лежит в .gitignore — реальные ключи в репозиторий НЕ попадут. Коммитится только .env.example.

# ── Основной стек: HF Inference ────────────────────────────────────────────────
# Бесплатный токен: https://huggingface.co/settings/tokens  (роль read).
# Тот же HF_TOKEN, что в модулях 10 и 10.7 — нового заводить не нужно.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Модель (необязательно). По умолчанию в ноутбуке — Qwen/Qwen2.5-Coder-32B-Instruct.
HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# ── Альтернатива: любой OpenAI-совместимый провайдер (например MiniMax) ──────────
# Это для задачи 3 «смени провайдера». Если используете — раскомментируйте и в
# ячейке создания клиента переключитесь на OpenAI-совместимый клиент с этими env.
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M3
