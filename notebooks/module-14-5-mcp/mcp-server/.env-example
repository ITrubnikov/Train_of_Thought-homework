# Скопируйте этот файл в .env (cp .env-example .env) и впишите значения.
# .env закрыт .gitignore-ом репозитория — под-токен не должен попадать в git.
# Настоящие переменные окружения важнее .env: клиент (ноутбук, Claude Code)
# может передать токен через env подпроцесса, не трогая файл.

# Под-токен вашего жителя: интерфейс игры -> экран «Жители» -> скопировать токен
COGNOPOLIS_TOKEN=

# Какой мир: по умолчанию — живая игра https://kindomklaster.com, менять не нужно.
# Если у вас запущен ЛОКАЛЬНЫЙ движок игры — раскомментируйте строку ниже, и сервер
# целиком переключится на него. ВАЖНО: под-токен выше должен быть из ТОГО ЖЕ мира
# (у локальной игры свои жители и свои токены — берите на её экране «Жители»),
# иначе любой авторизованный вызов ответит invalid_token.
# COGNOPOLIS_BASE_URL=http://localhost:8000
