# Скопируйте этот файл в .env (cp .env-example .env) и впишите значения.
# .env закрыт .gitignore-ом репозитория — под-токен не должен попадать в git.
# Настоящие переменные окружения важнее .env: клиент (ноутбук, Claude Code)
# может передать токен через env подпроцесса, не трогая файл.

# Под-токен вашего жителя: интерфейс игры -> экран «Жители» -> скопировать токен
COGNOPOLIS_TOKEN=

# Адрес игры менять не нужно; переопределяйте только для локального сервера движка
# COGNOPOLIS_BASE_URL=https://kindomklaster.com
