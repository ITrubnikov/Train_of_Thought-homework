# Скопируйте этот файл в .env и впишите СВОЙ ключ. Реальный .env не коммитим.
#
# Ноутбук написан на Anthropic SDK (как лекция). Достаточно ключа Anthropic.
# OPENAI_API_KEY нужен, только если будете адаптировать примеры на OpenAI.

ANTHROPIC_API_KEY=sk-ant-замените-на-свой-ключ
OPENAI_API_KEY=sk-замените-на-свой-ключ

# Опционально (блок 8 — дешёвый сторонний провайдер MiniMax, OpenAI-совместимый):
# MINIMAX_API_KEY=замените-на-ключ-с-platform.minimax.io
