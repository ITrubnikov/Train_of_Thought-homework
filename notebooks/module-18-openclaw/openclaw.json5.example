// Фрагмент учебного конфига ~/.openclaw/openclaw.json (формат JSON5).
// Онбординг создаёт полный конфиг сам — НЕ заменяйте его этим файлом целиком,
// берите отсюда только нужные ключи (или ставьте их через `openclaw config set`).
{
  channels: {
    telegram: {
      enabled: true,
      botToken: "123456:ABC...",        // токен от @BotFather; лежит плейнтекстом — не коммитьте файл
      dmPolicy: "pairing",              // незнакомцы получают код, их текст не доходит до модели
      allowFrom: ["123456789"],         // ваш числовой id — без него cron не доставит в личку
      groups: { "*": { requireMention: true } },
    },
  },
  agents: {
    defaults: {
      // На время домашки дежурство не нужно — пульс выключен.
      // Включая обратно, начните с дешёвого режима:
      //   every: "1h", isolatedSession: true, lightContext: true, model: "<дешёвая модель>"
      heartbeat: { every: "0m" },
    },
  },
}
